{
  "name": "specification-guided-development",
  "version": "0.1.0",
  "description": "TLA+ models, TLC automata, generated TypeScript and Rust linters, and agent plugins for specification-guided development.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sgd": "dist/cli.js"
  },
  "files": [
    "dist",
    "tools/rust-bindings",
    "plugins",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:rust-bindings && npm run test:codex-host-protocol",
    "test:rust-bindings": "cargo test --locked --manifest-path tools/rust-bindings/Cargo.toml --target-dir .runtime/rust-binding-tool",
    "plugins:package": "node plugins/package.mjs",
    "plugins:verify": "node scripts/verify-plugins.mjs",
    "verify:ingestion": "node scripts/verify-ingestion.mjs",
    "verify:partition": "node examples/partition-control/verify-model.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepare": "npm run build",
    "verify:codex-host": "node scripts/verify-codex-host.mjs",
    "test:codex-host-protocol": "node --test scripts/verify-codex-host.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@ts-graphviz/ast": "^3.0.6",
    "pele": "^1.9.0",
    "saxes": "6.0.0",
    "typescript": "7.0.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimSeogyu/specification-guided-development.git"
  }
}
