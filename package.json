{
  "name": "specification-guided-development",
  "version": "0.3.0-alpha.2",
  "description": "Generate TypeScript and Rust domains and TypeScript source checks from TLA+ models.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sgd": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    "proofs/domain",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "plugins:package": "node plugins/package.mjs",
    "plugins:verify": "node scripts/verify-plugins.mjs",
    "verify:ingestion": "node scripts/verify-ingestion.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepare": "npm run build",
    "demo:retained": "npm run build && node scripts/demo-retained.mjs",
    "proofs:check": "node scripts/check-reference-proofs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@ts-graphviz/ast": "^3.0.6",
    "pele": "^1.9.0",
    "saxes": "6.0.0",
    "typescript": "7.0.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimSeogyu/specification-guided-development.git"
  }
}
