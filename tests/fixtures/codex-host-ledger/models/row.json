{
  "version": 5,
  "profile": "row-owned",
  "name": "LedgerRow",
  "spec": "LedgerRow.tla",
  "config": "LedgerRow.cfg",
  "application": "..",
  "targets": [
    "typescript",
    "rust"
  ],
  "binding": {
    "className": "LedgerRowMachine",
    "rustCrateMode": "standalone",
    "row": {
      "version": 1,
      "profile": "rust-whole-row-v1",
      "source": {
        "manifest": "Cargo.toml",
        "module": "crate::facts",
        "facts": [
          {
            "name": "LedgerFact",
            "rustPath": "crate::LedgerFact",
            "metadata": [
              "received"
            ]
          }
        ]
      },
      "model": {
        "payloadInput": "v",
        "provenanceInput": "provenance",
        "pairs": [
          {
            "name": "stored",
            "payload": "stored",
            "provenance": "storedProvenance"
          },
          {
            "name": "rejected",
            "payload": "rejected",
            "provenance": "rejectedProvenance"
          }
        ]
      }
    }
  }
}
